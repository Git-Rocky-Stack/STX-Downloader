<Project>
  <!-- Who made it, carried in every built file's properties. Version is the one place the release number is set:
       tools/Publish.ps1 reads it, and a test holds the browser extension's manifest to it. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Company>Strategia-X</Company>
    <Authors>Rocky Elsalaymeh</Authors>
    <Product>STX Downloader</Product>
    <Copyright>Copyright (c) 2026 Rocky Elsalaymeh, Strategia-X</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <!-- A warning is a defect waiting: the build fails on one, so none can pile up unseen (review 2026-11-07). -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
