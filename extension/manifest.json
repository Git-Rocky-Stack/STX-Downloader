{
  "manifest_version": 3,
  "name": "STX Downloader",
  "version": "1.2.0",
  "description": "Finds media on the current tab and hands it to the STX Downloader app.",
  "author": { "email": "support@strategia-x.com" },
  "homepage_url": "https://strategia-x.com",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "key": "",
  "permissions": [
    "webRequest",
    "tabs",
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_title": "STX Downloader"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
