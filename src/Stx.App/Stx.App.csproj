<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>STXDownloader</AssemblyName>
    <AssemblyTitle>STX Downloader</AssemblyTitle>
    <RootNamespace>Stx.App</RootNamespace>
    <ApplicationIcon>Assets\stx.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness: see the manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- The VideoView that LibVLC draws into (spike S1). Its LibVLCSharp.dll carries the core API too, with the same
         identity (3.10.2.0) as the core package Stx.Playback uses, so that package's own copy is left out here. -->
    <PackageReference Include="LibVLCSharp.WinUI" />
    <PackageReference Include="LibVLCSharp" ExcludeAssets="compile;runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stx.Look\Stx.Look.csproj" />
    <ProjectReference Include="..\Stx.Art\Stx.Art.csproj" />
    <ProjectReference Include="..\Stx.ViewModels\Stx.ViewModels.csproj" />
    <ProjectReference Include="..\Stx.Data\Stx.Data.csproj" />
    <ProjectReference Include="..\Stx.Bridge\Stx.Bridge.csproj" />
    <ProjectReference Include="..\Stx.Playback\Stx.Playback.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\badge.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\stx.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tutorial.mp4" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tutorial-poster.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- dotnet publish leaves out the compiled XAML of an unpackaged WinUI app. Without these three, every styled control has no template: no faceplates, no pads. -->
  <Target Name="PublishCompiledXaml" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri;$(OutDir)App.xbf" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="$(OutDir)Themes\Generic.xbf" DestinationFolder="$(PublishDir)Themes" />
  </Target>
</Project>
