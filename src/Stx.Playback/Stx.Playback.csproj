<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The engine STX ships: the official VLC build and the FluidR3_GM SoundFont, pinned in tools/vlc/engine.json. -->
    <StxEngineVersion>3.0.24</StxEngineVersion>
    <StxEngineDir>$(MSBuildThisFileDirectory)..\..\.engine\$(StxEngineVersion)\</StxEngineDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- The core API only. The app takes LibVLCSharp.WinUI, whose LibVLCSharp.dll has the same identity (3.10.2.0) plus the VideoView. -->
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stx.Core\Stx.Core.csproj" />
  </ItemGroup>
  <!-- Fetches and checks the engine into .engine/ (git-ignored), then copies it beside every app and test that
       references this project, under libvlc\, where LibVLCSharp's Core.Initialize() looks for it.
       It runs again whenever engine.json or Get-Engine.ps1 is newer than ready.stamp. With only an Exists() check,
       a machine that already had an engine kept it after engine.json changed (Phase 4's DVD plugins never arrived). -->
  <Target Name="StxPrepareEngine" BeforeTargets="GetCopyToOutputDirectoryItems;CopyFilesToOutputDirectory"
          Inputs="$(MSBuildThisFileDirectory)..\..\tools\vlc\engine.json;$(MSBuildThisFileDirectory)..\..\tools\vlc\Get-Engine.ps1;$(MSBuildThisFileDirectory)..\..\tools\vlc\Make-Sf3.cs"
          Outputs="$(StxEngineDir)ready.stamp">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\vlc\Get-Engine.ps1&quot;" />
  </Target>
  <Target Name="StxEngineFiles" BeforeTargets="GetCopyToOutputDirectoryItems" DependsOnTargets="StxPrepareEngine">
    <ItemGroup>
      <_StxEngine Include="$(StxEngineDir)libvlc\**\*" />
      <ContentWithTargetPath Include="@(_StxEngine)" TargetPath="libvlc\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
